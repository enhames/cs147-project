  {"id":"json-telemetry","type":"json","z":"plant-tab-t24","name":"Parse telemetry JSON","property":"payload","action":"obj","pretty":false,"x":350,"y":100,"wires":[["split-telemetry","gap-detector","csv-row","debug-telemetry"]]},
  {"id":"split-telemetry","type":"function","z":"plant-tab-t24","name":"Dashboard fields","func":"const p = msg.payload || {};\nreturn [\n {payload:Number(p.moisture_raw), topic:'Raw ADC'},\n {payload:p.moisture_pct == null ? 0 : Number(p.moisture_pct), topic:'Moisture %'},\n {payload:String(p.soil_status || 'UNKNOWN'), topic:'Soil status'},\n {payload:p.temp_c == null ? 0 : Number(p.temp_c), topic:'Temperature'},\n {payload:Number(p.uptime_s || 0), topic:'Uptime'},\n {payload:Number(p.rssi || 0), topic:'RSSI'},\n {payload:Number(p.moisture_raw), topic:'Raw ADC'},\n {payload:p.moisture_pct == null ? null : Number(p.moisture_pct), topic:'Moisture %'}\n];","outputs":8,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":580,"y":100,"wires":[["ui-raw"],["ui-moisture"],["ui-soil-status"],["ui-temp"],["ui-uptime"],["ui-rssi"],["chart-raw"],["chart-moisture"]]},
  {"id":"gap-detector","type":"function","z":"plant-tab-t24","name":"Sequence gap detector","func":"const p=msg.payload||{};\nconst boot=Number(p.boot_count||0);\nconst seq=Number(p.seq||0);\nconst previous=context.get('previous');\nlet gap=null;\nif(previous && previous.boot===boot && seq>previous.seq+1){\n const missing=seq-previous.seq-1;\n gap={payload:`Missing ${missing} message(s): seq ${previous.seq+1}-${seq-1}`,topic:'Sequence gap'};\n}\ncontext.set('previous',{boot,seq,receivedAt:Date.now()});\nreturn [gap,{payload:seq,topic:'Last sequence'}];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":590,"y":300,"wires":[["ui-gap","debug-gap"],["ui-seq"]]},
  {"id":"csv-row","type":"function","z":"plant-tab-t24","name":"Create reliability CSV row","func":"const p=msg.payload||{};\nconst fields=[new Date().toISOString(),p.team,p.device_id,p.boot_count,p.seq,p.uptime_s,p.moisture_raw,p.moisture_pct,p.soil_status,p.temp_c,p.rssi,p.wifi_reconnects,p.mqtt_reconnects,p.reset_reason];\nmsg.payload=fields.map(v=>v==null?'':String(v)).join(',')+'\\n';\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":610,"y":380,"wires":[["csv-file"]]},
  {"id":"csv-file","type":"file","z":"plant-tab-t24","name":"Append reliability CSV","filename":"plant_t24_reliability.csv","filenameType":"str","appendNewline":false,"createDir":true,"overwriteFile":"false","encoding":"none","x":870,"y":380,"wires":[[]]},
  {"id":"mqtt-status","type":"mqtt in","z":"plant-tab-t24","name":"T24 online/offline","topic":"iot/T24/plant/status","qos":"1","datatype":"auto-detect","broker":"plant-broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":130,"y":460,"wires":[["status-normalize"]]},
  {"id":"status-normalize","type":"function","z":"plant-tab-t24","name":"Normalize retained status","func":"let state='unknown';\ntry{const p=typeof msg.payload==='string'?JSON.parse(msg.payload):msg.payload; state=String(p.state||p).toLowerCase();}catch(e){state=String(msg.payload).toLowerCase();}\nconst previous=context.get('state');\ncontext.set('state',state);\nconst display={payload:state.toUpperCase(),topic:'Device status'};\nconst alert=(state==='offline'&&previous!=='offline')?{payload:'ALERT: T24 plant monitor is OFFLINE',topic:'Offline alert'}:null;\nreturn [display,alert];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":460,"wires":[["ui-device-status"],["ui-alert"]]},
  {"id":"mqtt-alert","type":"mqtt in","z":"plant-tab-t24","name":"Plant alerts","topic":"iot/T24/plant/alert","qos":"0","datatype":"auto-detect","broker":"plant-broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":120,"y":540,"wires":[["json-alert"]]},
