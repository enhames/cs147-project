  {"id":"format-alert","type":"function","z":"plant-tab-t24","name":"Format plant alert","func":"const p=msg.payload||{}; msg.payload=`${p.event||'plant event'}: ${p.moisture_pct??'uncalibrated'}% (raw ${p.moisture_raw})`; return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":530,"y":540,"wires":[["ui-alert"]]},
