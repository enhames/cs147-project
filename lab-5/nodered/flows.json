  {
    "id": "a5f0c1d2e3b4010c",
    "type": "function",
    "z": "a5f0c1d2e3b40001",
    "name": "offline transition detector",
    "func": "const current = String(msg.payload).trim().toLowerCase();\nconst previous = context.get('state');\ncontext.set('state', current);\n\n// Fire once only when the retained status changes to offline.\nif (current === 'offline' && previous !== 'offline') {\n    return { payload: 'ALERT: T24 device offline at ' + new Date().toLocaleString() };\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 360,
    "wires": [
      [
        "a5f0c1d2e3b4010d",
        "a5f0c1d2e3b4010e"
      ]
    ]
  },
