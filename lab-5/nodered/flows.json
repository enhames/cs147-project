  {
    "id": "a5f0c1d2e3b40120",
    "type": "function",
    "z": "a5f0c1d2e3b40001",
    "name": "telemetry fields for dashboard",
    "func": "const p = msg.payload || {};\n\nconst temp = { payload: Number(p.temp_c), topic: 'Temperature' };\nconst history = { payload: Number(p.temp_c), topic: 'Temperature' };\nconst pressure = { payload: Number(p.press_hpa), topic: 'Pressure' };\nconst knob = { payload: Number(p.pot_pct), topic: 'Knob' };\n\nreturn [temp, history, pressure, knob];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
